# --- Mail.ru IMAP + SMTP ---
# Полный e-mail для входа (используется и для IMAP, и для SMTP)
MAILRU_LOGIN=info@casc.kz
# Пароль приложения (НЕ обычный пароль от почты!).
# Получить: https://account.mail.ru/user/2-step-auth/passwords
MAILRU_APP_PASSWORD=замените_на_пароль_приложения
# Имя отправителя для писем из веб-интерфейса
MAILRU_SENDER_NAME=ТОО CASC

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-замените
# Опционально: какую модель использовать. По умолчанию — Haiku 4.5.
# Альтернативы: claude-sonnet-4-6, claude-opus-4-7
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Параметры выгрузки ---
# С какой даты тянуть письма (YYYY-MM-DD)
START_DATE=2026-04-13
