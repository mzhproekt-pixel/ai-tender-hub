# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=manufacturers
POSTGRES_USER=mdb
POSTGRES_PASSWORD=mdb

# HTTP — many open registries require a contact email in the User-Agent
HTTP_USER_AGENT=manufacturers-db/0.1 (your-email@example.com)
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# Output
EXPORT_DIR=./exports

# Optional API tokens (most sources are anonymous)
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_KEY=
UN_COMTRADE_KEY=
